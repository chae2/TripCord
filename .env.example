# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 개발 중에는 길드(서버) 단위로 즉시 등록하기 위해 사용, 운영에서는 비워두고 글로벌 등록
DISCORD_DEV_GUILD_ID=

# Postgres (Supabase connection string)
# DATABASE_URL: 런타임 쿼리용 pooler 연결 (포트 6543, Transaction pooler)
# DIRECT_URL:   `prisma migrate`용 direct 연결 (포트 5432). Supabase 대시보드 > Project Settings > Database >
#               Connection string에서 "Direct connection"을 선택해 복사한다. 이게 없으면 migrate 명령이 멈춘 것처럼 보인다.
DATABASE_URL=
DIRECT_URL=

# Supabase Storage (사진 갤러리 미러링)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PHOTO_BUCKET=trip-photos

# RapidAPI - 항공권/숙소 검색
RAPIDAPI_KEY=
RAPIDAPI_FLIGHT_HOST=sky-scanner3.p.rapidapi.com
RAPIDAPI_HOTEL_HOST=agoda-com.p.rapidapi.com

# OpenWeatherMap
OPENWEATHER_API_KEY=

# 카카오 로컬 API (/추천 명령어)
KAKAO_REST_API_KEY=

# 여행 알림(날씨/준비물)을 보낼 채널. 미지정 시 /여행등록을 실행한 채널을 사용
NOTIFY_CHANNEL_ID=

# 스케줄러 기준 시간대
TIMEZONE=Asia/Seoul
