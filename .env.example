# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 개발 중에는 길드(서버) 단위로 즉시 등록하기 위해 사용, 운영에서는 비워두고 글로벌 등록
DISCORD_DEV_GUILD_ID=

# Postgres (Supabase connection string) - Project Settings > Database > Connection string
# DATABASE_URL: 런타임 쿼리용 "Transaction pooler" (포트 6543)
# DIRECT_URL:   `prisma migrate`용 "Session pooler" (포트 5432, 호스트는 DATABASE_URL과 동일).
#               "Direct connection"(db.<ref>.supabase.co)은 IPv6 전용이라 대부분의 로컬 네트워크에서
#               연결이 안 되니 반드시 Session pooler를 쓸 것 — 안 그러면 migrate가 멈추거나 P1001 에러가 난다.
DATABASE_URL=
DIRECT_URL=

# Supabase Storage (사진 갤러리 미러링)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PHOTO_BUCKET=trip-photos

# RapidAPI - 항공권/숙소 검색. RapidAPI 마켓플레이스에서 아래 두 상품을 검색해
# "Subscribe"(무료 Basic 플랜)까지 눌러야 동작한다 (호스트 이름으로 검색하면 나온다).
# - 항공권: 호스트 flights-sky.p.rapidapi.com ("Flights Scraper Sky", publisher: ntd119).
#           Sky Scrapper(apiheya, sky-scrapper.p.rapidapi.com)와 데이터 출처(Skyscanner)는 같지만
#           별도 구독/할당량이라 한쪽 무료 한도가 차면 이쪽으로 바꿔서 계속 쓸 수 있다.
#           참고로 sky-scrapper3(kevinagustiansyah298)는 항공권 API가 아니라 범용 URL 스크레이핑
#           프록시라 절대 쓰지 말 것.
# - 숙소:   호스트 booking-com15.p.rapidapi.com ("Booking.com")
RAPIDAPI_KEY=
RAPIDAPI_FLIGHT_HOST=flights-sky.p.rapidapi.com
RAPIDAPI_HOTEL_HOST=booking-com15.p.rapidapi.com

# OpenWeatherMap
OPENWEATHER_API_KEY=

# 카카오 로컬 API (/추천, /점메추, /저메추 - 한국 지역 카페/맛집)
KAKAO_REST_API_KEY=

# 네이버 검색 API (/추천 놀거리|기념품 - 한국 지역). developers.naver.com에서 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Yahoo!로컬서치API (/추천 카페|놀거리|기념품 - 일본 지역). developer.yahoo.co.jp에서 Client ID 발급
YAHOO_CLIENT_ID=

# 핫페퍼 구르메API (/추천 맛집, /점메추, /저메추 - 일본 지역). webservice.recruit.co.jp/register 에서 발급
HOTPEPPER_API_KEY=

# 여행 알림(날씨/준비물)을 보낼 채널. 미지정 시 /여행등록을 실행한 채널을 사용
NOTIFY_CHANNEL_ID=

# 스케줄러 기준 시간대
TIMEZONE=Asia/Seoul

# 웹 대시보드 URL (/갤러리 임베드에 링크로 표시, 선택)
WEB_BASE_URL=
