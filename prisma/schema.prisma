generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TripStatus {
  PLANNING
  ONGOING
  DONE
}

enum PackingScope {
  PERSONAL
  SHARED
}

model Guild {
  id            String   @id // discord guild snowflake
  activeTripId  String?  @unique
  notifyChannelId String?
  createdAt     DateTime @default(now())

  trips Trip[] @relation("GuildTrips")
}

model Trip {
  id                  String     @id @default(cuid())
  guildId             String
  guild               Guild      @relation("GuildTrips", fields: [guildId], references: [id])
  destination         String
  startDate           DateTime
  endDate             DateTime
  status              TripStatus @default(PLANNING)
  weatherLastPolledAt DateTime?
  dailyReminderSentAt DateTime?
  createdAt           DateTime   @default(now())

  scheduleItems ScheduleItem[]
  expenses      Expense[]
  photos        Photo[]
  packingItems  PackingItem[]
  weatherSnapshots WeatherSnapshot[]
  roles         Role[]
  participants  Participant[]

  @@index([guildId, status])
}

model ScheduleItem {
  id         String    @id @default(cuid())
  tripId     String
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayNumber  Int
  content    String
  location   String? // 텍스트 또는 링크
  time       String? // 자유 형식, 예: "14:00"
  createdBy  String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@index([tripId, dayNumber])
}

model Role {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  assignments RoleAssignment[]

  @@unique([tripId, name])
}

model RoleAssignment {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userId String

  @@unique([roleId, userId])
}

model Participant {
  id            String   @id @default(cuid())
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  discordUserId String
  displayName   String
  avatarUrl     String?
  introName     String?
  nickname      String?
  likes         String?
  dislikes      String?
  quirks        String?
  extra         String?
  updatedAt     DateTime @updatedAt

  @@unique([tripId, discordUserId])
}

model Expense {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payerId   String
  amount    Int
  memo      String?
  createdAt DateTime @default(now())

  shares ExpenseShare[]

  @@index([tripId])
}

model ExpenseShare {
  id          String  @id @default(cuid())
  expenseId   String
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId      String
  shareAmount Int

  @@index([expenseId])
}

model Photo {
  id              String   @id @default(cuid())
  tripId          String
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  discordMessageId String  @unique
  uploaderId      String
  storageUrl      String
  postedAt        DateTime @default(now())
  dayNumber       Int?
  locationTag     String?

  @@index([tripId, dayNumber])
  @@index([tripId, locationTag])
}

model PackingItem {
  id        String       @id @default(cuid())
  tripId    String
  trip      Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String // PERSONAL: 소유자, SHARED: 추가한 사람(작성자 표시용)
  scope     PackingScope @default(PERSONAL)
  item      String
  checked   Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([tripId, userId])
  @@index([tripId, scope])
}

model WeatherSnapshot {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  forecastFor DateTime
  tempC       Float
  condition   String
  polledAt    DateTime @default(now())

  @@unique([tripId, forecastFor])
}
